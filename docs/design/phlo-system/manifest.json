  "libraries": [],
  "components": [
    {
      "name": "InkSettling",
      "group": "Page",
      "summary": "Live speech appears in ink-wet and settles into ink as Phlo places it under the right heading."
    },
    {
      "name": "Role",
      "group": "Page",
      "summary": "The Partner/Scribe switch sets Phlo's role for a session, and the corner label tells the room which role is on."
    },
    {
      "name": "Symbol",
      "group": "Marks",
      "summary": "The split bubble is Phlo's symbol: a vermilion half-circle (voice) and an ink square with a tail (the page), separated by a small gap."
    },
    {
      "name": "Tab",
      "group": "Page",
      "summary": "A flat sticky-tab flag that marks anything Phlo pulled out, flagged or researched."
    },
    {
      "name": "VoiceDot",
      "group": "Marks",
      "summary": "A solid vermilion disc that is the mic, the recording state and the app icon."
    },
    {
      "name": "Wordmark",
      "group": "Marks",
      "summary": "The lockup pairs the split-bubble symbol with a quiet lowercase phlo set in Geist Medium."
    }
